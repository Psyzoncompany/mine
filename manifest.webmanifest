{
  "name": "Meu Craft - Minecraft Clone",
  "short_name": "MeuCraft",
  "description": "Minecraft-like browser game built with Three.js",
  "start_url": "/minecraft.html",
  "display": "standalone",
  "orientation": "landscape",
  "background_color": "#78A7FF",
  "theme_color": "#78A7FF",
  "icons": [
    {
      "src": "/assets/icons/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/assets/icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
